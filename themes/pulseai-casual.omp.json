{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 1,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [

        {
          "type": "text",
          "style": "plain",
          "foreground": "#888888",
          "template": " {{ env \"PULSE_MACHINE_ICON\" }} "
        },

        {
          "type": "path",
          "style": "plain",
          "foreground": "#ffffff",
          "properties": {
            "style": "agnoster_short"
          }
        },

        {
          "type": "text",
          "style": "plain",
          "foreground": "#00ff5f",
          "template": " ❯"
        }

      ]
    }
  ]
}
