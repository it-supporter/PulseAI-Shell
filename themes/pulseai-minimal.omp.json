{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [

        {
  "type": "text",
  "style": "plain",
  "foreground": "#00afff",
  "template": " {{ env \"PULSE_MACHINE_ICON\" }} {{ env \"PULSE_MACHINE_NAME\" }} "
},

        {
  "type": "session",
  "style": "plain",
  "foreground": "#ffaf00",
  "template": "{{ if env \"SSH_CONNECTION\" }} {{ .UserName }}@{{ .HostName }} {{ end }}"
}

,

        {
  "type": "git",
  "style": "powerline",
  "powerline_symbol": "",
  "background": "transparent",
  "template": " {{ .HEAD }}{{ if .Working.Changed }} ✏{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }} ",
  "foreground_templates": [

    "{{ if and (not .Working.Changed) (eq .Ahead 0) (eq .Behind 0) }}#666666{{ end }}",

    "{{ if and (eq .HEAD \"main\") (.Working.Changed) }}#ff2a2a{{ end }}",
    "{{ if and (eq .HEAD \"main\") (or (gt .Ahead 0) (gt .Behind 0)) }}#ff5f5f{{ end }}",

    "{{ if and (eq .HEAD \"dev\") (.Working.Changed) }}#00ff87{{ end }}",
    "{{ if and (eq .HEAD \"dev\") (or (gt .Ahead 0) (gt .Behind 0)) }}#5fffaf{{ end }}",

    "{{ if and (hasPrefix .HEAD \"feature/\") (.Working.Changed) }}#ffd75f{{ end }}",
    "{{ if and (hasPrefix .HEAD \"feature/\") (or (gt .Ahead 0) (gt .Behind 0)) }}#ffaf00{{ end }}",

    "{{ if gt .Behind 0 }}#ff005f{{ end }}"
  ],
  "foreground": "#aaaaaa",
  "properties": {
    "fetch_status": true,
    "fetch_upstream_icon": false,
    "branch_icon": ""
  }
}
,

        {
          "type": "path",
          "style": "plain",
          "foreground": "#ffffff",
          "properties": {
            "style": "agnoster_short"
          }
        },

        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt (atoi (env \"PULSE_LOAD_MS\")) 300 }}#ff5f5f{{ end }}",
            "{{ if and (gt (atoi (env \"PULSE_LOAD_MS\")) 150) (le (atoi (env \"PULSE_LOAD_MS\")) 300) }}#ffaa00{{ end }}"
          ],
          "template": "{{ if gt (atoi (env \"PULSE_LOAD_MS\")) 150 }} {{ env \"PULSE_LOAD_MS\" }}ms{{ end }}"
        },

        {
          "type": "text",
          "style": "plain",
          "foreground": "#00ff5f",
          "template": " ❯"
        }

      ]
    }
  ]
}
